# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (anchored to repo root so it does not shadow the
# src/components/coverage source dir, which Tailwind must scan)
/coverage

# next.js
apps/web/.next/
# Side-by-side prod build dir (NEXT_DIST_DIR), e.g. running `next start` on one
# port while `next dev` uses `.next` on another.
apps/web/.next-*/
apps/web/out/

# production
apps/web/build

# react-flagpack assets (copied via postinstall)
apps/web/public/flags

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.perf-trace.log

# generated openapi spec + generator cache (regenerated on postinstall / predev / prebuild)
apps/web/src/services/openapi/openapi.generated.json
apps/web/src/services/sdk/local-routes.generated.ts
apps/web/src/proxy-routes.generated.ts
# Per-locale dictionary modules (static imports of src/locales/<locale>/**.json)
apps/web/src/locales/generated/
# glossary markdown compiled for core (source of truth is entries/<category>/*.md)
# One module per language, written from content/glossary/<locale>/**.md on
# postinstall/predev/prebuild. The single-file predecessor was already ignored;
# the folder that replaced it was not, so 9.3 MB of machine output was staged.
apps/web/src/services/glossary/generated/
apps/web/src/services/glossary/entries.generated.ts
apps/web/.openapi-gen/

# temp / scratch working dir (tool outputs, not tracked)
/temp/
